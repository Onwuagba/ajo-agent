# Copy to .env. With nothing set, the API runs on the in-process PayPal simulator and the rules-based parser.
AJO_DB=ajo.db
PAYPAL_MODE=fake                  # fake | sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# AJO_LLM=auto                    # auto (default: use a local Ollama model if one is running) | ollama | none | openai_compat | anthropic
# AJO_OLLAMA_URL=http://localhost:11434
# AJO_LLM=openai_compat           # none | openai_compat (Nebius Token Factory, any OpenAI-compatible API) | anthropic. Without a key the chat is read by built-in rules and says so
# AJO_LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
# AJO_LLM_API_KEY=
# AJO_LLM_MODEL=
